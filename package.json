{
  "name": "seavibes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --port=4173 --host=127.0.0.1",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "check": "node tests/run-checks.mjs",
    "mock:generate": "node scripts/generate-mock.mjs",
    "test": "vitest run",
    "screenshots": "vite build && node tests/screenshots.mjs",
    "build:remote": "vite build --mode remote",
    "deploy:preview": "npm run build:remote && wrangler pages deploy dist --project-name seavibes --branch preview"
  },
  "dependencies": {
    "@fontsource/assistant": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "lucide-react": "0.546.0",
    "motion": "12.43.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.8.3",
    "vite": "6.4.6",
    "vitest": "4.1.12",
    "wrangler": "4.161.0"
  }
}
